# Copy this file to .env and tweak values as needed.

# ── Pro mode (Agentic RAG) ────────────────────────────────────────────────────
FASTEST_RESPONSE_MODE=0
ENABLE_QUERY_REWRITE=1
ENABLE_CLARIFICATION_GATE=1
ENABLE_SELF_CHECK=1

# ── Agentic RAG Phase 2 ───────────────────────────────────────────────────────
ENABLE_HYDE=0                   # HyDE query expansion (costs 1 LLM call per query)
CRAG_RELEVANCE_THRESHOLD=40     # Min similarity (%) to skip LLM CRAG check
ENABLE_PERSISTENT_MEMORY=1      # Save chat history to SQLite

# ── Generation budget ─────────────────────────────────────────────────────────
GENERATION_MAX_NEW_TOKENS=512
REWRITE_MAX_NEW_TOKENS=24
GENERATION_MAX_TIME_SEC=30

# ── Retrieval and rerank ──────────────────────────────────────────────────────
TOP_K=6
SIMILARITY_THRESHOLD=40
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RERANK_EMBEDDING_WEIGHT=0.75
RERANK_KEYWORD_WEIGHT=0.25
RERANKER_MAX_CHARS=500

# ── Chunking ──────────────────────────────────────────────────────────────────
MIN_CHUNK_CHARS=120
ENABLE_CHUNK_DEDUP=1
MAX_CHUNKS_PER_SECTION=2000
PDF_MARGIN_REPEAT_RATIO=0.8

# ── Embedding (SOTA Vietnamese default; re-upload docs after switching) ───────
# EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding_v2
# EMBEDDING_USE_E5_PREFIX=0     # 1 = force E5 query:/passage: prefixes (for e5-small rollback)
# VECTOR_COLLECTION=            # Pin collection name; empty = auto per embedding model.
#                               # Rollback to old index: VECTOR_COLLECTION=company_documents
#                               # + EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ── LLM (SOTA safe default: Sailor2-8B Q4_K_S, ~4.99GB, fits 6GB VRAM) ──────────
# LLM_MODEL=bartowski/Sailor2-8B-Chat-GGUF
# LLM_GGUF_FILENAME=Sailor2-8B-Chat-Q4_K_S.gguf
# Fallbacks: Qwen2.5-7B Q4_K_M (lighter) / Sailor2 IQ4_XS (lightest ~4.71GB)
# LLM_MODEL=bartowski/Qwen2.5-7B-Instruct-GGUF
# LLM_GGUF_FILENAME=Qwen2.5-7B-Instruct-Q4_K_M.gguf
# LLM_CHAT_FORMAT=chatml
# LLM_N_CTX=4096                # Keep 4096 on RTX 3060 6GB
# LLM_N_GPU_LAYERS=-1           # Lower (e.g. 30) if OOM

# ── Observability lite (traces JSONL + GET /api/traces luôn bật) ───────────────
# LANGFUSE_ENABLED=0            # 1 = forward trace sang Langfuse self-host
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# (pip install langfuse>=2.0 khi bật; tắt mặc định để nhẹ RAM/VRAM)

# ── Hybrid fusion (weighted SOTA mặc định; rrf để rollback) ───────────────────
# HYBRID_FUSION=weighted        # weighted | rrf
# HYBRID_DENSE_WEIGHT=0.7       # trọng số dense 0..1 (phần còn lại cho BM25)
# HYBRID_RRF_K=60

# ── Reranker (SOTA Vietnamese default; CPU frees VRAM for LLM) ───────────────
# RERANKER_MODEL=AITeamVN/Vietnamese_Reranker
# RERANKER_DEVICE=auto          # auto | cuda | cpu (cpu = an toàn VRAM 6GB)
# Rollback nhẹ hơn: RERANKER_MODEL=BAAI/bge-reranker-base

# ── GraphRAG-lite (opt-in; upload lại tài liệu sau khi bật) ───────────────────
# ENABLE_GRAPH_RAG=0           # 1 = bật Knowledge Graph SQLite + 1-hop expansion
# GRAPH_MAX_EXPAND=3           # chunk graph tối đa thêm vào mỗi query
# GRAPH_USE_LLM=0              # 1 = trích triple bằng LLM local lúc ingest (chậm hơn)

# ── Document parsing (SOTA: Docling CPU when installed, else PyPDF2) ─────────
# DOC_PARSER=auto              # auto | pypdf | docling
# DOCLING_ARTIFACTS_PATH=./data/models/docling

# ── Security (RBAC-lite: read vs write keys; API_KEY luôn full-quyền) ─────────
# API_KEY=your-secret-key       # Uncomment to enable API key auth
# API_READ_KEYS=reader-1,reader-2   # GET: search/stats/docs/traces/jobs/history
# API_WRITE_KEYS=writer-1           # POST/DELETE: upload/delete/sessions (read-key không đủ)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Async ingest (in-process jobs; không cần Redis) ──────────────────────────
# ENABLE_ASYNC_INGEST=0         # 1 = /api/upload trả job_id, poll tại /api/jobs/{id}
# (file nặng Docling/OCR nên bật; 1 worker để an toàn RAM)

# ── Rate Limiting (per IP, sliding window) ────────────────────────────────────
RATE_LIMIT_REQUESTS=30          # Max requests per window
RATE_LIMIT_WINDOW_SEC=60        # Window size in seconds
